# .gitignore for Chat2 project
# Ignore OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Java / Maven
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
*.log

# IntelliJ / JetBrains
.idea/
*.iml
out/

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/

# Gradle
.gradle/
build/

# Node / frontend
**/node_modules/
/frontend/node_modules/
/frontend/dist/
/build/
npm-debug.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# Environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Spring / Spring Boot config
**/application.yml
**/application-*.yml

# Docker
docker-compose.override.yml
docker-compose.*.yml
.docker/
docker-compose.yml.local

# Docker image layers / archives
*.tar
*.tgz

# Terraform
.terraform/
terraform.tfstate
terraform.tfstate.backup
crash.log
override.tf
override.tf.json
*.tfvars

# AWS / Credentials & secrets
credentials
aws-credentials.json
*.pem
*.key
*.p12
*.jks

# Build / distribution
dist/
bin/
obj/

# Coverage / reports
coverage/
jacoco.exec
coverage-final.json

# Other
*.class
*.log
*.tmp
*.out
*.swp

# Ignore local IDE run configs and OS files
*.iml
*.ipr
*.iws

# Keep the maven wrapper jar committed, don't ignore ".mvn/wrapper/maven-wrapper.jar"

/localstack-data